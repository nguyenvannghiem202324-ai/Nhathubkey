-- ==================== NHẬT HUB - AUTO HOP 1 PLAYER (MINI VERSION) ====================
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo bộ nhớ lưu các server đã từng vào (Tránh vào lại server cũ)
if not getgenv().VisitedServers then
    getgenv().VisitedServers = {}
end
table.insert(getgenv().VisitedServers, game.JobId)

-- Hàm quét và chuyển đến Server đúng 1 người
local function HopToServer1Player()
    local cursor = ""
    local candidates = {}
    local maxPages = 15 -- Quét 15 trang để tìm được nhiều server hơn

    for page = 1, maxPages do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end

        local success, result = pcall(function()
            return game:HttpGet(url)
        end)

        if success and result then
            local data = HttpService:JSONDecode(result)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    -- Lọc chuẩn xác: Đúng 1 người + Chưa từng thử + Khác server hiện tại
                    if type(server) == "table" and server.playing == 1 then
                        if not table.find(getgenv().VisitedServers, server.id) and server.id ~= game.JobId then
                            table.insert(candidates, server.id)
                        end
                    end
                end
            end

            if data.nextPageCursor and data.nextPageCursor ~= "null" then
                cursor = data.nextPageCursor
            else
                break
            end
        else
            break
        end
        task.wait(0.05)
    end

    -- Thực hiện chuyển Server
    if #candidates > 0 then
        local targetJobId = candidates[math.random(1, #candidates)]
        table.insert(getgenv().VisitedServers, targetJobId)

        local teleportConnection
        teleportConnection = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            teleportConnection:Disconnect()
            task.wait(1)
            HopToServer1Player()
        end)

        TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
    else
        -- NẾU HẾT SERVER MỚI: Tự động xóa danh sách server cũ để tìm lại từ đầu
        getgenv().VisitedServers = {game.JobId}
        task.wait(1)
        HopToServer1Player()
    end
end

